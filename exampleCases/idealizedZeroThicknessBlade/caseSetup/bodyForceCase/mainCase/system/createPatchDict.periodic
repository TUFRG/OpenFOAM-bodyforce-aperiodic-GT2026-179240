FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
pointSync false;

tol 3e-5;

// Patches to create

patches
(
    {
        name Per0;

        patchInfo
        {
            type cyclicSlip;
            neighbourPatch Per1;

            transform rotational;
            rotationAxis   (0 0 1);
            rotationCentre (0 0 0);

            matchTolerance $tol;
        }

        constructFrom patches;

        patches (pPer);
    }
    {
        name Per1;

        patchInfo
        {
            type cyclicSlip;
            neighbourPatch Per0;

            transform rotational;
            rotationAxis   (0 0 1);
            rotationCentre (0 0 0);

            matchTolerance $tol; 
        }

        constructFrom patches;

        patches (nPer);
    }
);


//************************************************************************ //
