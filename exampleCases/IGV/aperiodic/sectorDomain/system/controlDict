// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     rhoSimpleFoamBF;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime        18000;

deltaT          1;

writeControl    runTime;

writeInterval   100;

purgeWrite      2;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    flowRatePatch(name=inlet)
    {
        name            inlet;
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             yes;
        regionType      patch;
        fields          ( phi );
        operation       sum;
    }
    flowRatePatch(name=outlet)
    {
        name            outlet;
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             yes;
        regionType      patch;
        fields          ( phi );
        operation       sum;
    }
    yPlus
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        writeFields     yes;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    totalPressureFunc
    {
        type            pressure;
        libs            ( fieldFunctionObjects );
        mode            isentropic;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    vorticity1
    {
        type            vorticity;
        libs            ( fieldFunctionObjects );
        enabled         true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    MachNumber
    {
        type            MachNo;
        libs            ( "libfieldFunctionObjects.so" );
        enabled         true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    totalTField
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           totalT;
        expression      "T + sqr(mag(U))/(2*1004.5)";
        dimensions      [ 0 0 0 1 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    entropyField
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           entropy;
        expression      "1004.5*log(totalT/288.15) - 287.7*log('isentropic(p)'/101325)";
        dimensions      [ 0 2 -2 -1 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    coordinateTransform
    {
        type            fieldCoordinateSystemTransform;
        libs            ( fieldFunctionObjects );
        log             true;
        fields          ( U );
        executeControl  writeTime;
        writeControl    writeTime;
        coordinateSystem
        {
            type            cylindrical;
            origin          ( 0 0 0 );
            rotation
            {
                type            cylindrical;
                axis            (1 0 0);
            }
        }
    }
    flowAngle
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           alphaFlow;
        expression      "radToDeg(atan2('U:Transformed'.y(),'U:Transformed'.z()))";
        dimensions      [ 0 0 0 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    corrField
    {
        type            exprField;
        libs            ( "libfieldFunctionObjects.so" );
        field           corr;
        expression      "sqrt(totalT/288.15)/('isentropic(p)'/101325)";
        dimensions      [ 0 0 0 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    radialFlowAngle
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           radialFlow;
        expression      "radToDeg(atan2('U:Transformed'.x(),'U:Transformed'.z()))";
        dimensions      [ 0 0 0 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    VthRel
    {
        type            exprField;
        libs            ( "libfieldFunctionObjects.so" );
        field           Urel;
        variables       ( "x = pos().x()" 
        				  "y = pos().y()" 
        				  "r = sqrt((x*x)+(y*y))" 
        				  "Uy = ('U:Transformed'.y())");
        expression      "Uy - (r * 0)";
        dimensions      [ 0 1 -1 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    relAphaFlow
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           relFlow;
        expression      "radToDeg(atan2(Urel,'U:Transformed'.z()))";
        dimensions      [ 0 0 0 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    massAvgInletpt
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        enabled         yes;
        log             yes;
        writeFields     yes;
        surfaceFormat   raw;
        regionType      patch;
        name            inlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( p T isentropic(p) totalT entropy U rho alphaFlow radialFlow corr Ma Urel relFlow U:Transformed);
        executeControl  writeTime;
        writeControl    writeTime;
    }
    massAvgOutletpt
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        log             yes;
        writeFields     yes;
        surfaceFormat   raw;
        regionType      patch;
        name            outlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( p T isentropic(p) totalT entropy U rho alphaFlow radialFlow corr Ma Urel relFlow U:Transformed);
        executeControl  writeTime;
        writeControl    writeTime;
    }
    linesample
    {
        type            sets;
        libs            ( "libsampling.so" );
        executeControl  writeTime;
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       csv;
        sets            ( line1 // This is the rotor inlet
        				{ type uniform ; 
        				nPoints 200 ; 
        				start (-0.126 0.157068 0.00104636 ) ; 
        				end ( -0.126 0.0598746 0.00274163 ) ; 
        				axis xyz ; } 
        				line2  // This is rotor outlet
        				{ type uniform ; 
        				nPoints 200 ; 
        				start ( 0.02 0.0522103 0.000911334) ; 
        				end ( 0.02 0.152672 0.0026649) ; 
        				axis xyz ; });
        fields          ( p T isentropic(p) totalT entropy U rho alphaFlow radialFlow corr Ma Urel relFlow U:Transformed);
    }
}


