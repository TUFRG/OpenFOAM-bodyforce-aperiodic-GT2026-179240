// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// The axis of rotation of this machine is the z axis
// Hence the radial direction is denoted x and the axial direction is z (x = mz + c)
// There are three positions in the circumferential cordinate in this domain 
// The positive rotation is represented as p and negative as n while the middle position is represented as m

scale  1; //0.001; // The data came in millimeters so this converts it to m (SI units)
tol 3e-3;

//ptsX 200; //This is the number of cells along X
ptsY 30; // This is the number of cells along Z
//ptsZ 50;

ptX1 135.0;
ptX2 116.0;
ptX3 191.0;

ptsZ 94.0;

x1P 0.12181540493939327;
x2P 0.2690190197474956;
x3P 0.0553555974350084;
z1P 0.09781405788834344;
z2P 0.09781405788834344;
z3P 0.09781405788834344;
 
x1N 0.4338982403332305;
x2N 0.3433609677857968;
x3N 0.36558583880291795;
z1N 0.1702127659574468;
z2N 0.1702127659574468;
z3N 0.1702127659574468;

x1upG 0.07863713226936993;
x2upG 0.23591139680810977;
x3upG 0.07863713226936993;
z1upG 5.927178356336234;
z2upG 5.927178356336234;
z3upG 5.927178356336234;

x1mG 1;
x2mG 1;
x3mG 1;
z1mG 1;
z2mG 1;
z3mG 1;

z1G 0.3;
z3G  7;
 
x1dwG 8.477759137795276;
x2dwG 4.238879568897638;
x3dwG 12.716638706692915;
z1dwG 0.1687143426232461;
z2dwG 0.1687143426232461;
z3dwG 0.1687143426232461;

B 4;		//Number of blades
Angle #eval{360/$B};		//Angle for 2 blade passages
pAng #eval{0.5*$Angle};		//positive Angle
nAng #eval{-0.5*$Angle};	//negative Angle

xInH -0.32212051596088964;
rInH 0.05988544284000001;
xInC -0.32212051596088964;
rInC 0.1570960763076;

xLEH -0.05821804790970867;
rLEH 0.05718102334788649;
xLEC -0.04964107478460678;
rLEC 0.15452885371741348;

xTEH -0.029160287542347847;
rTEH 0.05321306699922518;
xTEC -0.014295549892993312;
rTEC 0.1531989824575728;

xOutH 0.35189697484320004;
rOutH 0.07534564187982214;
xOutC 0.35189697484320004;
rOutC 0.1478252606691894;

x0r0m ($xInH $rInH 0);
x0r1m ($xInC $rInC 0);

x1r0p ($xInH #eval{$rInH * cos(degToRad($pAng))} #eval{$rInH * sin(degToRad($pAng))});
x1r1p ($xInC #eval{$rInC * cos(degToRad($pAng))} #eval{$rInC * sin(degToRad($pAng))});
x2r0p ($xLEH #eval{$rLEH * cos(degToRad($pAng))} #eval{$rLEH * sin(degToRad($pAng))});
x2r1p ($xLEC #eval{$rLEC * cos(degToRad($pAng))} #eval{$rLEC * sin(degToRad($pAng))});
x3r0p ($xTEH #eval{$rTEH * cos(degToRad($pAng))} #eval{$rTEH * sin(degToRad($pAng))});
x3r1p ($xTEC #eval{$rTEC * cos(degToRad($pAng))} #eval{$rTEC * sin(degToRad($pAng))});
x4r0p ($xOutH #eval{$rOutH * cos(degToRad($pAng))} #eval{$rOutH * sin(degToRad($pAng))});
x4r1p ($xOutC #eval{$rOutC * cos(degToRad($pAng))} #eval{$rOutC * sin(degToRad($pAng))});

x1r0n ($xInH #eval{$rInH * cos(degToRad($nAng))} #eval{$rInH * sin(degToRad($nAng))});
x1r1n ($xInC #eval{$rInC * cos(degToRad($nAng))} #eval{$rInC * sin(degToRad($nAng))});
x2r0n ($xLEH #eval{$rLEH * cos(degToRad($nAng))} #eval{$rLEH * sin(degToRad($nAng))});
x2r1n ($xLEC #eval{$rLEC * cos(degToRad($nAng))} #eval{$rLEC * sin(degToRad($nAng))});
x3r0n ($xTEH #eval{$rTEH * cos(degToRad($nAng))} #eval{$rTEH * sin(degToRad($nAng))});
x3r1n ($xTEC #eval{$rTEC * cos(degToRad($nAng))} #eval{$rTEC * sin(degToRad($nAng))});
x4r0n ($xOutH #eval{$rOutH * cos(degToRad($nAng))} #eval{$rOutH * sin(degToRad($nAng))});
x4r1n ($xOutC #eval{$rOutC * cos(degToRad($nAng))} #eval{$rOutC * sin(degToRad($nAng))});

x4r0m ($xOutH $rOutH 0);
x4r1m ($xOutC $rOutC 0);

geometry
{
	hub
	{
		type 	triSurfaceMesh;
		file	"hub.stl";
	}
	LE
	{
		type	triSurfaceMesh;
		file	"LE.stl";		
	}
	TE
	{
		type	triSurfaceMesh;
		file	"TE.stl";		
	}
	cas
	{
		type 	triSurfaceMesh;
		file	"casing.stl";
	}
	inlet
	{
    	type searchablePlane;
    	planeType embeddedPoints;
    	embeddedPointsDict
    	{
    		point1	$x1r0p;
			point2	$x1r0n;
			point3	$x1r1p; 
       	}
	}
	outlet
	{
    	type searchablePlane;
    	planeType embeddedPoints;
    	embeddedPointsDict
    	{
    		point1	$x4r0p;
			point2	$x4r0n;
			point3	$x4r1p; 
       	}
	}
	nPer
	{
    	type searchablePlane;
    	planeType embeddedPoints;
    	embeddedPointsDict
    	{
    		point1	$x1r0n;
			point2	$x1r1n;
			point3	$x4r1n; 
       	}
	}	
	pPer
	{
    	type searchablePlane;
    	planeType embeddedPoints;
    	embeddedPointsDict
    	{
    		point1	$x1r0p; 
			point2	$x1r1p; 
			point3	$x4r1p;
       	}
	}		
}
