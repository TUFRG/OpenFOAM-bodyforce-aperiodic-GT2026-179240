 	hex (Px2r0 Px3r0 Nx3r0 Nx2r0 Px2r1 Px3r1 Nx3r1 Nx2r1) Stator ($ptX2 $ptsY $ptsZ) 
 	simpleGrading 
 	(
		(
			($x2P $x2N $x2dwG)
			(#eval{1 - 2*$x2P} #eval{1 - 2*$x2N} $x2mG)
			($x2P $x2N  $x2upG)
		)	
		1 
		(
			($z2P $z2N $z2upG)
			(#eval{1 - 2*$z2P} #eval{1 - 2*$z2N} $z2mG)
			($z2P $z2N  $z2dwG)
		)
	)
 	hex (Px3r0 Px4r0 Nx4r0 Nx3r0 Px3r1 Px4r1 Nx4r1 Nx3r1) ($ptX3 $ptsY $ptsZ) 
