FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      chordwisePos;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   #codeStream

{

codeInclude
#{
	#include "fvCFD.H"
//	#define CGAL_EXACT_PREDICATES_INEXACT_CONSTRUCTIONS_KERNEL_H
//	#include </usr/local/include/CGAL/Exact_predicates_inexact_constructions_kernel.h>
//	#include </usr/local/include/CGAL/Delaunay_triangulation_2.h>
//	#include </usr/local/include/CGAL/Interpolation_traits_2.h>
//	#include </usr/local/include/CGAL/natural_neighbor_coordinates_2.h>
//	#include </usr/local/include/CGAL/interpolation_functions.h>
	#include <IFstream.H>
	#include <OFstream.H>
	#include <ctime>
	#include "clock.H"
	#include "string.H"
	#include <sstream>
	#include <iomanip>
#};

codeOptions
#{
-I$(LIB_SRC)/finiteVolume/lnInclude \
-I$(LIB_SRC)/meshTools/lnInclude
#};

codeLibs
#{
-lmeshTools \
-lfiniteVolume
#};

code
#{
		
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());	
        scalarField chordwisePos(mesh.nCells(), 0);

		label zoneID = mesh.cellZones().findZoneID("Rotor");
		const labelList& 	cellr	= mesh.cellZones()[zoneID]; // list of cells in BF zone

		label zoneIDs = mesh.cellZones().findZoneID("Stator");
		const labelList& 	cells	= mesh.cellZones()[zoneIDs]; // list of cells in BF zone

	    List<scalar> xC_data;
        IFstream xC("xC_data");
       	xC  >> xC_data;

        forAll(cellr, i)
        {               
			chordwisePos[cellr[i]] = xC_data[cellr[i]];			
        }
        forAll(cells, i)
        {
        	chordwisePos[cells[i]] = xC_data[cells[i]];
        }
        chordwisePos.writeEntry("", os);

                
#};

};

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    } 

    #includeEtc "caseDicts/setConstraintTypes"
}


