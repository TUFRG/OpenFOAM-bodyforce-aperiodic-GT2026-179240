// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

//libs            ( turbulenceModelSchemes );

application     rhoSimpleFoam_BF;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2000;

deltaT          1;

writeControl    runTime;

writeInterval   250;

purgeWrite      1;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    flowRatePatch(name=Inlet)
    {
        name            Inlet;
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        writeFields		false;
        executeControl  writeTime;
        writeControl    writeTime;
        log             yes;
        regionType      patch;
        fields          ( phi );
        operation       sum;
    }
    flowRatePatch(name=Outlet)
    {
        name            Outlet;
        type            surfaceFieldValue;
        libs            ( "libfieldFunctionObjects.so" );
        writeFields		false;
        executeControl  writeTime;
        writeControl    writeTime;;
        log             yes;
        regionType      patch;
        fields          ( phi );
        operation       sum;
    }
    yPlus
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        writeFields     yes;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    totalPressureFunc
    {
        type            pressure;
        libs            ( fieldFunctionObjects );
        mode            isentropic;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    vorticity1
    {
        type            vorticity;
        libs            ( fieldFunctionObjects );
        enabled         true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    MachNumber
    {
        type            MachNo;
        libs            ( "libfieldFunctionObjects.so" );
        enabled         true;
        executeControl  writeTime;
        writeControl    writeTime;
    }
    totalTField
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           totalT;
        expression      "T + sqr(mag(U))/(2*1004.5)";
        dimensions      [ 0 0 0 1 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
    entropyField
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           entropy;
        expression      "1004.5*log(totalT/288.15) - 287.7*log('isentropic(p)'/101325)";
        dimensions      [ 0 2 -2 -1 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
/*
    components1
    {
        type            components;
        libs            ( fieldFunctionObjects );
        field           U;
        executeControl  writeTime;
        writeControl    writeTime;
    }
*/
    coordinateTransform
    {
        type            fieldCoordinateSystemTransform;
        libs            ( fieldFunctionObjects );
        log             true;
        fields          ( U );
        executeControl  writeTime;
        writeControl    writeTime;
        coordinateSystem
        {
            type            cylindrical;
            origin          ( 0 0 0 );
            rotation
            {
                type            cylindrical;
                axis            ( 1 0 0 );
            }
        }
    }
    flowAngle
    {
        type            exprField;
        libs            ( fieldFunctionObjects );
        field           alphaFlow;
        expression      "radToDeg(atan2('U:Transformed'.y(),'U:Transformed'.z()))"; // tangential / axial
        dimensions      [ 0 0 0 0 0 0 0 ];
        executeControl  writeTime;
        writeControl    writeTime;
    }
/*
    massAvgInletpt
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        enabled         yes;
        writeControl    timeStep;
        log             yes;
        writeFields     yes;
        surfaceFormat   raw;
        regionType      patch;
        name            Inlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( p T isentropic(p) totalT entropy U rho alphaFlow );
        writeInterval   1000;
    }
    massAvgOutletpt
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        writeControl    timeStep;
        log             yes;
        writeFields     yes;
        surfaceFormat   raw;
        regionType      patch;
        name            Outlet;
        operation       weightedAverage;
        weightField     phi;
        fields          ( p T isentropic(p) totalT entropy U rho alphaFlow );
        writeInterval   1000;
    }
*/
    linesample
    {
        type            sets;
        libs            ( "libsampling.so" );
        executeControl  writeTime;
        writeControl    writeTime;
        interpolationScheme cell;
        setFormat       csv;
        sets            ( line1 { type uniform ; nPoints 1000 ; start ( 0 0 1.05 ) ; end ( 2 0 1.05 ) ; axis xyz ; } line2 { type uniform ; nPoints 200 ; start ( 0.501 0 1 ) ; end ( 0.501 0 1.1 ) ; axis xyz ; } line3 { type uniform ; nPoints 200 ; start ( 2 0 1 ) ; end ( 2 0 1.1 ) ; axis xyz ; } );
        fields          ( p T isentropic(p) totalT entropy U:Transformed rho alphaFlow );
    }
}


