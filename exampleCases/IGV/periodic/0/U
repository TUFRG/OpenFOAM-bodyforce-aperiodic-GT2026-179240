FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

Uz				166;
internalField   uniform ($Uz 0 0);
boundaryField
{
	#includeEtc "caseDicts/setConstraintTypes"
    


	inlet
	{
		 type           pressureInletOutletVelocity;
		 rho 			rho;
		 phi 			phi;
		 value 			uniform (0 0 0);		 
	}
	outlet
	{
		type            inletOutlet;
		value			uniform (0 0 0);
		inletValue      uniform (0 0 0);		
	}	
	hub
	{
		type			noSlip;
	}
	casing
	{
       type            noSlip;			
	}
}


