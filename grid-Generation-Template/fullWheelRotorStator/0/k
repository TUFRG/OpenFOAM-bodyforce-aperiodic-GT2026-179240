FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];	

I 0.05;

U 166;

val #eval{1.5*$I*$I*$U*$U}; //k=1.5*I^2*U^2	

//internalField   uniform $val;
internalField   uniform 1.5;

boundaryField
{
	#includeEtc "caseDicts/setConstraintTypes"

	inlet
	{
        type            turbulentIntensityKineticEnergyInlet;
        intensity   	$I;
        value           $internalField;	 	
	}
    outlet
    {
        type            zeroGradient;  
    }
	rotorHubRotating
	{
       type            kqRWallFunction;
       value           uniform 0;	
	}
	casing 
	{
       type            kqRWallFunction;
       value           uniform 0;			
	}
	rotorHubStationary
	{
       type            kqRWallFunction;
       value           uniform 0;	
	}
	FarDwStrmCas 
	{
       type            kqRWallFunction;
       value           uniform 0;			
	}
	FarDwStrmHub
	{
       type            kqRWallFunction;
       value           uniform 0;			
	}
	FarUpstrmCas
	{
       type            kqRWallFunction;
       value          uniform 0;			
	}		
}


