FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
pointSync false;

tol 1e-5;

// Patches to create

patches
(
    {
        name pPer1;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (pPer);
    }
    {
        name nPer1;

        patchInfo
        {
            type wall; 
        }

        constructFrom patches;

        patches (nPer);
    }
    {
        name rotorHubRotating;  // New patch name
        patchInfo
        {
            type wall;
        }
        constructFrom set; //patches;        
        // Define the region using a box or other selection
        set rotorHubRotating;
    } 
    {
        name rotorHubStationary;  // New patch name
        patchInfo
        {
            type wall;
        }
        constructFrom set; //patches;
        set rotorHubStationary;
    }  
    {
        name FarDwStrmHub;  // New patch name
        patchInfo
        {
            type wall;
        }
        constructFrom set; //patches;        
        // Define the region using a box or other selection
        set FarDwStrmHub;
    }
    {
        name FarDwStrmCas;  // New patch name
        patchInfo
        {
            type wall;
        }
        constructFrom set; //patches;
        set FarDwStrmCas;
    }       
);


