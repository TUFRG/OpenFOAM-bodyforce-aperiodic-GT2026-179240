(
    {
        name pPer1;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (pPer);
    }
    {
        name nPer1;

        patchInfo
        {
            type wall; 
        }

        constructFrom patches;

        patches (nPer);
    }
