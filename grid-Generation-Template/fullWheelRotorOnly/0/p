FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];


internalField   uniform 101325;

boundaryField
{
	#includeEtc "caseDicts/setConstraintTypes"
	
	inlet
	{
		type 			totalPressure;
		rho				rho;
		psi				thermo:psi;
		gamma			1.4;
		p0				uniform 101325;
		value			uniform 101325;        	
	}
    outlet
    {
        type            fixedValue;      
        value           uniform 80000;
    }
	rotorHubRotating
	{
       type            fixedFluxPressure;       	
	}
	rotorHubStationary
	{
       type            fixedFluxPressure;       	
	}	
	casing
	{
       type            fixedFluxPressure;       		
	}
	FarDwStrmCas
	{
       type            fixedFluxPressure;       		
	}
	FarDwStrmHub
	{
       type            fixedFluxPressure;       		
	}			
}


