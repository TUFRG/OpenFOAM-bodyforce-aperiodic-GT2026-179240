FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      camber;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];


internalField   #codeStream

{

codeInclude
#{
	#include "fvCFD.H"
	#include <IFstream.H>
	#include <OFstream.H>
	#include <ctime>
	#include "clock.H"
	#include "string.H"
	#include <sstream>
	#include <iomanip>
#};

codeOptions
#{
-I$(LIB_SRC)/finiteVolume/lnInclude \
-I$(LIB_SRC)/meshTools/lnInclude
#};

codeLibs
#{
-lmeshTools \
-lfiniteVolume
#};

code
#{
		Pout<< " \n Calculating camber normals.... \n" << endl;
		
        const IOdictionary& d = static_cast<const IOdictionary&>(dict);
        const fvMesh& mesh = refCast<const fvMesh>(d.db());	
        vectorField camber(mesh.nCells(), vector(1e-4,1e-4,1e-4));

		label zoneID = mesh.cellZones().findZoneID("Rotor");
		const labelList& 	cellr	= mesh.cellZones()[zoneID]; // list of cells in BF zone

		label zoneIDs = mesh.cellZones().findZoneID("Stator");
		const labelList& 	cells	= mesh.cellZones()[zoneIDs]; // list of cells in BF zone

        List<scalar> Nz_data, Nth_data, Nr_data;
        IFstream nz("Nz_data");
        nz  >> Nz_data;
        IFstream nth("Nth_data");
        nth  >> Nth_data;
        IFstream nr("Nr_data");
        nr  >> Nr_data;

        forAll(cellr, i)
        {               
  	         camber[cellr[i]] = vector(Nz_data[cellr[i]],Nr_data[cellr[i]],Nth_data[cellr[i]]);      	                                                            
        }
        forAll(cells, i)
        {
        	 camber[cells[i]] = vector(Nz_data[cells[i]],Nr_data[cells[i]],Nth_data[cells[i]]);        	
        }
        camber.writeEntry("", os);

                
#};

};

boundaryField
{
    ".*"
    {
        type            zeroGradient;
    } 

    #includeEtc "caseDicts/setConstraintTypes"
}


